# Preserve local instruction files while allowing CI delivery, even when a
# machine-local exclude hides .github.
!/.github/
/.github/*
!/.github/workflows/

# Version only the deliverable skill packages inside each challenge project.
!code-smells-project/.agents/
!code-smells-project/.agents/skills/
!code-smells-project/.agents/skills/refactor-arch/
!code-smells-project/.agents/skills/refactor-arch/**
!ecommerce-api-legacy/.agents/
!ecommerce-api-legacy/.agents/skills/
!ecommerce-api-legacy/.agents/skills/refactor-arch/
