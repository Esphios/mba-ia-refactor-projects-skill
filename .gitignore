.env
.env.*
!.env.example
node_modules/

# Python
__pycache__/
*.pyc
.venv/
venv/

# SQLite
*.db
*.db-*
*.sqlite
*.sqlite3
instance/

# Local agent/editor state; keep .github and configuration examples visible.
/.agents/
.codex/
.claude/
.gemini/
.vscode/
.idea/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
