# Provide a new random value with at least 32 bytes; never commit .env.
SECRET_KEY=replace-with-a-new-random-secret
DATABASE=loja.db
HOST=127.0.0.1
PORT=5000
APP_ENV=production
# Legacy plaintext upgrade is disabled after this UTC instant.
LEGACY_PASSWORD_CUTOFF=2027-01-01T00:00:00+00:00
# Optional demo seed only; define new local values before running seed-demo.
DEMO_ADMIN_PASSWORD=replace-with-a-local-demo-password
DEMO_CUSTOMER_PASSWORD=replace-with-a-local-demo-password
DEMO_SECOND_CUSTOMER_PASSWORD=replace-with-a-local-demo-password
